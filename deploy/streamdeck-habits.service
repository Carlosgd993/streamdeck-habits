[Unit]
Description=Stream Deck - mostrar habitos de TickTick
After=systemd-udevd.service local-fs.target network-online.target
Wants=systemd-udevd.service network-online.target

[Service]
Type=simple
User=admin
ExecStart=/opt/streamdeck-habits/venv/bin/python /opt/streamdeck-habits/orchestrator.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target