

@token = {{$dotenv TICKTICK_ACCESS_TOKEN}}
@base_url ={{$dotenv TICKTICK_BASE_URL}}/project
@project_id = 6805f32f98c7581dd8beb6a1

### Get user projects
GET {{base_url}}
Authorization: Bearer {{token}}

### Get project by id
GET {{base_url}}/{{project_id}}
Authorization: Bearer {{token}}

### Get project with data
GET {{base_url}}/{{project_id}}/data
Authorization: Bearer {{token}}

### Create project
POST {{base_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "project name",
  "color": "#F18181",
  "viewMode": "list",
  "kind": "task"
}

### Update project
POST {{base_url}}/{{project_id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Project Name",
  "color": "#F18181",
  "viewMode": "list",
  "kind": "TASK"
}

### Delete project
DELETE {{base_url}}/{{project_id}}
Authorization: Bearer {{token}}
